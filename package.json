{
  "name": "resonant-dao-example",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "bash scripts/build.sh",
    "build:server": "tsc -p server/tsconfig.json",
    "build:client": "vite build --config client/vite.config.ts",
    "copy-wasm": "bash scripts/copy-wasm.sh",
    "postinstall": "npm run copy-wasm",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "ts-node-dev --transpile-only server/src/index.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "test": "jest server/test --runInBand",
    "test:server": "jest server/test --runInBand"
  },
  "dependencies": {
    "@vijayee/wavedb": "file:../WaveDB/bindings/nodejs",
    "crabs-wasm": "file:../CRABS/bindings/wasm",
    "eauth-wasm": "file:../EAuth/bindings/wasm",
    "express": "^4.19.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.46.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.10",
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.12",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
