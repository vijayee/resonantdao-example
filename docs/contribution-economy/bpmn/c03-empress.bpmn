<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_c03" targetNamespace="http://resonantdao.com/bpmn">
  <bpmn:process id="Process_c03" name="C_3 Empress — Nurturing" isExecutable="false">
    <bpmn:laneSet id="LaneSet_c03">
      <bpmn:lane id="c03_lane_member" name="Member">
        <bpmn:flowNodeRef>c03_start</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="c03_lane_reviewer" name="Reviewer">
        <bpmn:flowNodeRef>c03_task_verify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c03_gw_conflict</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c03_end_reject</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="c03_lane_system" name="System">
        <bpmn:flowNodeRef>c03_gw_cap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c03_end_nocap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c03_gw_cycle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c03_end_defer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c03_task_mult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c03_task_record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c03_end_balance</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="c03_start" name="A mentee's work was accepted"/>
    <bpmn:exclusiveGateway id="c03_gw_cap" name="Under the per-mentee cap?"/>
    <bpmn:endEvent id="c03_end_nocap" name="No share — cap exceeded"/>
    <bpmn:exclusiveGateway id="c03_gw_cycle" name="Is this round's window open?"/>
    <bpmn:endEvent id="c03_end_defer" name="Deferred to the next round"/>
    <bpmn:userTask id="c03_task_verify" name="Confirm the mentee's work was accepted"/>
    <bpmn:exclusiveGateway id="c03_gw_conflict" name="Clean of staged disputes?"/>
    <bpmn:endEvent id="c03_end_reject" name="Rejected — staged conflict"/>
    <bpmn:serviceTask id="c03_task_mult" name="Pay a share of the mentee's work"/>
    <bpmn:serviceTask id="c03_task_record" name="Save a decision record"/>
    <bpmn:endEvent id="c03_end_balance" name="C_3 tally updated"/>
    <bpmn:sequenceFlow id="c03_f1" sourceRef="c03_start" targetRef="c03_gw_cap"/>
    <bpmn:sequenceFlow id="c03_f2" name="no" sourceRef="c03_gw_cap" targetRef="c03_end_nocap"/>
    <bpmn:sequenceFlow id="c03_f3" name="yes" sourceRef="c03_gw_cap" targetRef="c03_gw_cycle"/>
    <bpmn:sequenceFlow id="c03_f4" name="no" sourceRef="c03_gw_cycle" targetRef="c03_end_defer"/>
    <bpmn:sequenceFlow id="c03_f5" name="yes" sourceRef="c03_gw_cycle" targetRef="c03_task_verify"/>
    <bpmn:sequenceFlow id="c03_f6" sourceRef="c03_task_verify" targetRef="c03_gw_conflict"/>
    <bpmn:sequenceFlow id="c03_f7" name="no" sourceRef="c03_gw_conflict" targetRef="c03_end_reject"/>
    <bpmn:sequenceFlow id="c03_f8" name="yes" sourceRef="c03_gw_conflict" targetRef="c03_task_mult"/>
    <bpmn:sequenceFlow id="c03_f9" sourceRef="c03_task_mult" targetRef="c03_task_record"/>
    <bpmn:sequenceFlow id="c03_f10" sourceRef="c03_task_record" targetRef="c03_end_balance"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_c03">
    <bpmndi:BPMNPlane id="Plane_c03" bpmnElement="Process_c03">
      <bpmndi:BPMNShape id="c03_pool_di" bpmnElement="Process_c03" isHorizontal="true">
