                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_c18" targetNamespace="http://resonantdao.com/bpmn">
  <bpmn:process id="Process_c18" name="C_18 Moon — Verifying" isExecutable="false">
    <bpmn:laneSet id="LaneSet_c18">
      <bpmn:lane id="c18_lane_member" name="Member">
        <bpmn:flowNodeRef>c18_start</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="c18_lane_reviewer" name="Human Reviewer">
        <bpmn:flowNodeRef>c18_task_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c18_task_rotate</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="c18_lane_system" name="System / Automation">
        <bpmn:flowNodeRef>c18_gw_queue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c18_end_drained</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c18_task_token</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c18_task_accuracy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c18_gw_capture</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c18_task_record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c18_task_feed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c18_end_balance</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="c18_start" name="Pending claim enqueued"/>
    <bpmn:exclusiveGateway id="c18_gw_queue" name="More pending claims?"/>
    <bpmn:endEvent id="c18_end_drained" name="Queue drained"/>
    <bpmn:userTask id="c18_task_check" name="Complete verification check"/>
    <bpmn:serviceTask id="c18_task_token" name="Verification token per completed check (any direction)"/>
    <bpmn:serviceTask id="c18_task_accuracy" name="Track accuracy vs chance"/>
    <bpmn:exclusiveGateway id="c18_gw_capture" name="Reviewer capture suspected?"/>
    <bpmn:userTask id="c18_task_rotate" name="Rotate reviewer pool (Tier 3)"/>
    <bpmn:serviceTask id="c18_task_record" name="Emit explanation record"/>
    <bpmn:serviceTask id="c18_task_feed" name="Verdicts feed all dimensions' pending claims"/>
    <bpmn:endEvent id="c18_end_balance" name="C_18 balance updated"/>
    <bpmn:sequenceFlow id="c18_f1" sourceRef="c18_start" targetRef="c18_gw_queue"/>
    <bpmn:sequenceFlow id="c18_f2" name="no" sourceRef="c18_gw_queue" targetRef="c18_end_drained"/>
    <bpmn:sequenceFlow id="c18_f3" name="yes" sourceRef="c18_gw_queue" targetRef="c18_task_check"/>
    <bpmn:sequenceFlow id="c18_f4" sourceRef="c18_task_check" targetRef="c18_task_token"/>
    <bpmn:sequenceFlow id="c18_f5" sourceRef="c18_task_token" targetRef="c18_task_accuracy"/>
    <bpmn:sequenceFlow id="c18_f6" sourceRef="c18_task_accuracy" targetRef="c18_gw_capture"/>
    <bpmn:sequenceFlow id="c18_f7" name="yes" sourceRef="c18_gw_capture" targetRef="c18_task_rotate"/>
    <bpmn:sequenceFlow id="c18_f8" name="no" sourceRef="c18_gw_capture" targetRef="c18_task_record"/>
    <bpmn:sequenceFlow id="c18_f9" sourceRef="c18_task_rotate" targetRef="c18_gw_queue"/>
    <bpmn:sequenceFlow id="c18_f10" sourceRef="c18_task_record" targetRef="c18_task_feed"/>
    <bpmn:sequenceFlow id="c18_f11" sourceRef="c18_task_feed" targetRef="c18_end_balance"/>
  </bpmn:process>
