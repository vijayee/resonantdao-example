<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_c17" targetNamespace="http://resonantdao.com/bpmn">
  <bpmn:process id="Process_c17" name="C_17 Star — Orientation" isExecutable="false">
    <bpmn:laneSet id="LaneSet_c17">
      <bpmn:lane id="c17_lane_member" name="Member">
        <bpmn:flowNodeRef>c17_start</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="c17_lane_reviewer" name="Reviewer">
        <bpmn:flowNodeRef>c17_task_session</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c17_gw_attend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c17_end_noattend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c17_gw_first</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c17_end_pending</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="c17_lane_system" name="System">
        <bpmn:flowNodeRef>c17_task_credit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c17_task_record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c17_task_feed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c17_end_balance</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="c17_start" name="A new member is being oriented"/>
    <bpmn:userTask id="c17_task_session" name="A person runs the orientation"/>
    <bpmn:exclusiveGateway id="c17_gw_attend" name="Only attendance, nothing more?"/>
    <bpmn:endEvent id="c17_end_noattend" name="No credit — showing up pays nothing"/>
    <bpmn:exclusiveGateway id="c17_gw_first" name="Did the new member finish first proven work?"/>
    <bpmn:endEvent id="c17_end_pending" name="Pending — no credit yet"/>
    <bpmn:serviceTask id="c17_task_credit" name="Credit the guide"/>
    <bpmn:serviceTask id="c17_task_record" name="Save a decision record"/>
    <bpmn:serviceTask id="c17_task_feed" name="Share entry progress with the Fool"/>
    <bpmn:endEvent id="c17_end_balance" name="C_17 tally updated"/>
    <bpmn:sequenceFlow id="c17_f1" sourceRef="c17_start" targetRef="c17_task_session"/>
    <bpmn:sequenceFlow id="c17_f2" sourceRef="c17_task_session" targetRef="c17_gw_attend"/>
    <bpmn:sequenceFlow id="c17_f3" name="yes" sourceRef="c17_gw_attend" targetRef="c17_end_noattend"/>
    <bpmn:sequenceFlow id="c17_f4" name="no" sourceRef="c17_gw_attend" targetRef="c17_gw_first"/>
    <bpmn:sequenceFlow id="c17_f5" name="no" sourceRef="c17_gw_first" targetRef="c17_end_pending"/>
    <bpmn:sequenceFlow id="c17_f6" name="yes" sourceRef="c17_gw_first" targetRef="c17_task_credit"/>
    <bpmn:sequenceFlow id="c17_f7" sourceRef="c17_task_credit" targetRef="c17_task_record"/>
    <bpmn:sequenceFlow id="c17_f8" sourceRef="c17_task_record" targetRef="c17_task_feed"/>
    <bpmn:sequenceFlow id="c17_f9" sourceRef="c17_task_feed" targetRef="c17_end_balance"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_c17">
    <bpmndi:BPMNPlane id="Plane_c17" bpmnElement="Process_c17">
      <bpmndi:BPMNShape id="c17_pool_di" bpmnElement="Process_c17" isHorizontal="true">
        <dc:Bounds x="80" y="80" width="1660" height="560"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="c17_lane_member_di" bpmnElement="c17_lane_member" isHorizontal="true">
