<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_c11" targetNamespace="http://resonantdao.com/bpmn">
  <bpmn:process id="Process_c11" name="C_11 Justice — Audits" isExecutable="false">
    <bpmn:laneSet id="LaneSet_c11">
      <bpmn:lane id="c11_lane_member" name="Member">
        <bpmn:flowNodeRef>c11_start</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="c11_lane_reviewer" name="Reviewer">
        <bpmn:flowNodeRef>c11_task_audit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="c11_lane_system" name="System">
        <bpmn:flowNodeRef>c11_task_token</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c11_gw_adjust</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c11_task_backpay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c11_gw_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c11_task_record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c11_end_balance</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="c11_start" name="An audit is scheduled"/>
    <bpmn:userTask id="c11_task_audit" name="Run the fairness audit by hand"/>
    <bpmn:serviceTask id="c11_task_token" name="Credit per finished audit"/>
    <bpmn:exclusiveGateway id="c11_gw_adjust" name="Were quiet kinds of work missed?"/>
    <bpmn:serviceTask id="c11_task_backpay" name="Trigger back-pay, retuning, or retirement"/>
    <bpmn:exclusiveGateway id="c11_gw_merge" name="Join paths"/>
    <bpmn:serviceTask id="c11_task_record" name="Save a decision record"/>
    <bpmn:endEvent id="c11_end_balance" name="C_11 tally updated"/>
    <bpmn:sequenceFlow id="c11_f1" sourceRef="c11_start" targetRef="c11_task_audit"/>
    <bpmn:sequenceFlow id="c11_f2" sourceRef="c11_task_audit" targetRef="c11_task_token"/>
    <bpmn:sequenceFlow id="c11_f3" sourceRef="c11_task_token" targetRef="c11_gw_adjust"/>
    <bpmn:sequenceFlow id="c11_f4" name="yes" sourceRef="c11_gw_adjust" targetRef="c11_task_backpay"/>
    <bpmn:sequenceFlow id="c11_f5" sourceRef="c11_task_backpay" targetRef="c11_gw_merge"/>
    <bpmn:sequenceFlow id="c11_f6" name="no" sourceRef="c11_gw_adjust" targetRef="c11_gw_merge"/>
    <bpmn:sequenceFlow id="c11_f7" sourceRef="c11_gw_merge" targetRef="c11_task_record"/>
    <bpmn:sequenceFlow id="c11_f8" sourceRef="c11_task_record" targetRef="c11_end_balance"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_c11">
    <bpmndi:BPMNPlane id="Plane_c11" bpmnElement="Process_c11">
      <bpmndi:BPMNShape id="c11_pool_di" bpmnElement="Process_c11" isHorizontal="true">
        <dc:Bounds x="80" y="80" width="1220" height="560"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="c11_lane_member_di" bpmnElement="c11_lane_member" isHorizontal="true">
