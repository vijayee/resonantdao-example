<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_c06" targetNamespace="http://resonantdao.com/bpmn">
  <bpmn:process id="Process_c06" name="C_6 Lovers — Joint Builds" isExecutable="false">
    <bpmn:laneSet id="LaneSet_c06">
      <bpmn:lane id="c06_lane_member" name="Member">
        <bpmn:flowNodeRef>c06_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c06_task_declare</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="c06_lane_reviewer" name="Reviewer">
        <bpmn:flowNodeRef>c06_task_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c06_gw_farm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c06_end_reject</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="c06_lane_system" name="System">
        <bpmn:flowNodeRef>c06_task_bounty</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c06_task_record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c06_task_feed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c06_end_balance</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="c06_start" name="A joint build is declared"/>
    <bpmn:userTask id="c06_task_declare" name="Declare who built what"/>
    <bpmn:userTask id="c06_task_review" name="Confirm it was a real joint build"/>
    <bpmn:exclusiveGateway id="c06_gw_farm" name="Clean of staged disputes?"/>
    <bpmn:endEvent id="c06_end_reject" name="Rejected — staged conflict"/>
    <bpmn:serviceTask id="c06_task_bounty" name="Split the reward by proven share"/>
    <bpmn:serviceTask id="c06_task_record" name="Save a decision record"/>
    <bpmn:serviceTask id="c06_task_feed" name="Link the accepted work to Magician"/>
    <bpmn:endEvent id="c06_end_balance" name="C_6 tally updated"/>
    <bpmn:sequenceFlow id="c06_f1" sourceRef="c06_start" targetRef="c06_task_declare"/>
    <bpmn:sequenceFlow id="c06_f2" sourceRef="c06_task_declare" targetRef="c06_task_review"/>
    <bpmn:sequenceFlow id="c06_f3" sourceRef="c06_task_review" targetRef="c06_gw_farm"/>
    <bpmn:sequenceFlow id="c06_f4" name="no" sourceRef="c06_gw_farm" targetRef="c06_end_reject"/>
    <bpmn:sequenceFlow id="c06_f5" name="yes" sourceRef="c06_gw_farm" targetRef="c06_task_bounty"/>
    <bpmn:sequenceFlow id="c06_f6" sourceRef="c06_task_bounty" targetRef="c06_task_record"/>
    <bpmn:sequenceFlow id="c06_f7" sourceRef="c06_task_record" targetRef="c06_task_feed"/>
    <bpmn:sequenceFlow id="c06_f8" sourceRef="c06_task_feed" targetRef="c06_end_balance"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_c06">
    <bpmndi:BPMNPlane id="Plane_c06" bpmnElement="Process_c06">
      <bpmndi:BPMNShape id="c06_pool_di" bpmnElement="Process_c06" isHorizontal="true">
        <dc:Bounds x="80" y="80" width="1280" height="560"/>
      </bpmndi:BPMNShape>
