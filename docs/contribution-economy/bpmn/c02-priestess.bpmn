<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_c02" targetNamespace="http://resonantdao.com/bpmn">
  <bpmn:process id="Process_c02" name="C_2 Priestess — Recording" isExecutable="false">
    <bpmn:laneSet id="LaneSet_c02">
      <bpmn:lane id="c02_lane_member" name="Member">
        <bpmn:flowNodeRef>c02_start</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="c02_lane_reviewer" name="Reviewer">
        <bpmn:flowNodeRef>c02_task_verify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c02_gw_more</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c02_gw_attrib</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c02_end_nocredit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="c02_lane_system" name="System">
        <bpmn:flowNodeRef>c02_gw_quality</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c02_end_notrecord</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c02_task_base</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c02_task_record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c02_task_rails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c02_end_balance</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="c02_start" name="Someone publishes a record"/>
    <bpmn:exclusiveGateway id="c02_gw_quality" name="Lasting, attributed, findable?"/>
    <bpmn:endEvent id="c02_end_notrecord" name="Not a record — no credit"/>
    <bpmn:serviceTask id="c02_task_base" name="Credit for publishing"/>
    <bpmn:userTask id="c02_task_verify" name="A reviewer confirms each real use"/>
    <bpmn:exclusiveGateway id="c02_gw_more" name="More confirmed uses?"/>
    <bpmn:exclusiveGateway id="c02_gw_attrib" name="Credited and findable?"/>
    <bpmn:endEvent id="c02_end_nocredit" name="No credit"/>
    <bpmn:serviceTask id="c02_task_record" name="Save a decision record"/>
    <bpmn:serviceTask id="c02_task_rails" name="These records support all dimensions"/>
    <bpmn:endEvent id="c02_end_balance" name="C_2 tally updated"/>
    <bpmn:sequenceFlow id="c02_f1" sourceRef="c02_start" targetRef="c02_gw_quality"/>
    <bpmn:sequenceFlow id="c02_f2" name="no" sourceRef="c02_gw_quality" targetRef="c02_end_notrecord"/>
    <bpmn:sequenceFlow id="c02_f3" name="yes" sourceRef="c02_gw_quality" targetRef="c02_task_base"/>
    <bpmn:sequenceFlow id="c02_f4" sourceRef="c02_task_base" targetRef="c02_task_verify"/>
    <bpmn:sequenceFlow id="c02_f5" sourceRef="c02_task_verify" targetRef="c02_gw_more"/>
    <bpmn:sequenceFlow id="c02_f6" name="yes" sourceRef="c02_gw_more" targetRef="c02_task_verify"/>
    <bpmn:sequenceFlow id="c02_f7" name="no" sourceRef="c02_gw_more" targetRef="c02_gw_attrib"/>
    <bpmn:sequenceFlow id="c02_f8" name="no" sourceRef="c02_gw_attrib" targetRef="c02_end_nocredit"/>
    <bpmn:sequenceFlow id="c02_f9" name="yes" sourceRef="c02_gw_attrib" targetRef="c02_task_record"/>
    <bpmn:sequenceFlow id="c02_f10" sourceRef="c02_task_record" targetRef="c02_task_rails"/>
    <bpmn:sequenceFlow id="c02_f11" sourceRef="c02_task_rails" targetRef="c02_end_balance"/>
  </bpmn:process>
