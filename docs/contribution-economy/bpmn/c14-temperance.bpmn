<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_c14" targetNamespace="http://resonantdao.com/bpmn">
  <bpmn:process id="Process_c14" name="C_14 Temperance — Health in Range" isExecutable="false">
    <bpmn:laneSet id="LaneSet_c14">
      <bpmn:lane id="c14_lane_member" name="Member">
        <bpmn:flowNodeRef>c14_start</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="c14_lane_reviewer" name="Human Reviewer">
        <bpmn:flowNodeRef>c14_task_stall</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="c14_lane_system" name="System / Automation">
        <bpmn:flowNodeRef>c14_gw_range</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c14_task_hold</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c14_task_record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c14_task_consume</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c14_end_balance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c14_gw_stall</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c14_end_none</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="c14_start" name="Health metric monitoring cycle"/>
    <bpmn:exclusiveGateway id="c14_gw_range" name="Metric in range?"/>
    <bpmn:serviceTask id="c14_task_hold" name="Holding credit per in-range interval"/>
    <bpmn:serviceTask id="c14_task_record" name="Emit explanation record"/>
    <bpmn:serviceTask id="c14_task_consume" name="Consumes resources released by C_13 Death"/>
    <bpmn:endEvent id="c14_end_balance" name="C_14 balance updated"/>
    <bpmn:exclusiveGateway id="c14_gw_stall" name="Stall detected?"/>
    <bpmn:userTask id="c14_task_stall" name="Stall remediation (human)"/>
    <bpmn:endEvent id="c14_end_none" name="No credit (out of range)"/>
    <bpmn:sequenceFlow id="c14_f1" sourceRef="c14_start" targetRef="c14_gw_range"/>
    <bpmn:sequenceFlow id="c14_f2" name="yes" sourceRef="c14_gw_range" targetRef="c14_task_hold"/>
    <bpmn:sequenceFlow id="c14_f3" sourceRef="c14_task_hold" targetRef="c14_task_record"/>
    <bpmn:sequenceFlow id="c14_f4" sourceRef="c14_task_record" targetRef="c14_task_consume"/>
    <bpmn:sequenceFlow id="c14_f5" sourceRef="c14_task_consume" targetRef="c14_end_balance"/>
    <bpmn:sequenceFlow id="c14_f6" name="no" sourceRef="c14_gw_range" targetRef="c14_gw_stall"/>
    <bpmn:sequenceFlow id="c14_f7" name="yes" sourceRef="c14_gw_stall" targetRef="c14_task_stall"/>
    <bpmn:sequenceFlow id="c14_f8" sourceRef="c14_task_stall" targetRef="c14_gw_range"/>
    <bpmn:sequenceFlow id="c14_f9" name="no" sourceRef="c14_gw_stall" targetRef="c14_end_none"/>
  </bpmn:process>
