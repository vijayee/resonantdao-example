                  id="Definitions_c07" targetNamespace="http://resonantdao.com/bpmn">
  <bpmn:process id="Process_c07" name="C_7 Chariot — Milestones" isExecutable="false">
    <bpmn:laneSet id="LaneSet_c07">
      <bpmn:lane id="c07_lane_member" name="Member">
        <bpmn:flowNodeRef>c07_start</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="c07_lane_reviewer" name="Human Reviewer">
        <bpmn:flowNodeRef>c07_task_verify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c07_gw_harm</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="c07_lane_system" name="System / Automation">
        <bpmn:flowNodeRef>c07_task_adjust</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c07_gw_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c07_task_token</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c07_task_record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c07_task_feed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c07_end_balance</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="c07_start" name="Milestone plan committed"/>
    <bpmn:userTask id="c07_task_verify" name="Verify milestone completion"/>
    <bpmn:exclusiveGateway id="c07_gw_harm" name="Harm detected (verified)?"/>
    <bpmn:serviceTask id="c07_task_adjust" name="Net-of-harm adjustment (reduce or void outcome)"/>
    <bpmn:exclusiveGateway id="c07_gw_merge" name="Merge paths"/>
    <bpmn:serviceTask id="c07_task_token" name="Milestone token"/>
    <bpmn:serviceTask id="c07_task_record" name="Emit explanation record"/>
    <bpmn:serviceTask id="c07_task_feed" name="Feed C_14 Temperance: milestone health context"/>
    <bpmn:endEvent id="c07_end_balance" name="C_7 balance updated"/>
    <bpmn:sequenceFlow id="c07_f1" sourceRef="c07_start" targetRef="c07_task_verify"/>
    <bpmn:sequenceFlow id="c07_f2" sourceRef="c07_task_verify" targetRef="c07_gw_harm"/>
    <bpmn:sequenceFlow id="c07_f3" name="yes" sourceRef="c07_gw_harm" targetRef="c07_task_adjust"/>
    <bpmn:sequenceFlow id="c07_f4" name="no" sourceRef="c07_gw_harm" targetRef="c07_gw_merge"/>
    <bpmn:sequenceFlow id="c07_f5" sourceRef="c07_task_adjust" targetRef="c07_gw_merge"/>
    <bpmn:sequenceFlow id="c07_f6" sourceRef="c07_gw_merge" targetRef="c07_task_token"/>
    <bpmn:sequenceFlow id="c07_f7" sourceRef="c07_task_token" targetRef="c07_task_record"/>
    <bpmn:sequenceFlow id="c07_f8" sourceRef="c07_task_record" targetRef="c07_task_feed"/>
    <bpmn:sequenceFlow id="c07_f9" sourceRef="c07_task_feed" targetRef="c07_end_balance"/>
  </bpmn:process>
