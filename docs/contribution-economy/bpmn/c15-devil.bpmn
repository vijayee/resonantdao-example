<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_c15" targetNamespace="http://resonantdao.com/bpmn">
  <bpmn:process id="Process_c15" name="C_15 Devil — Exposing" isExecutable="false">
    <bpmn:laneSet id="LaneSet_c15">
      <bpmn:lane id="c15_lane_member" name="Member">
        <bpmn:flowNodeRef>c15_start</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="c15_lane_reviewer" name="Reviewer">
        <bpmn:flowNodeRef>c15_task_corrob</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c15_gw_corr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c15_task_audit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="c15_lane_system" name="System">
        <bpmn:flowNodeRef>c15_task_penalty</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c15_end_penalty</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c15_task_bounty</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c15_task_record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c15_task_feed_c11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c15_end_balance</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="c15_start" name="Someone reports a skewed incentive"/>
    <bpmn:userTask id="c15_task_corrob" name="A second person confirms it"/>
    <bpmn:exclusiveGateway id="c15_gw_corr" name="Is the claim confirmed?"/>
    <bpmn:userTask id="c15_task_audit" name="A person audits the dimension weights"/>
    <bpmn:serviceTask id="c15_task_penalty" name="False-claim penalty"/>
    <bpmn:endEvent id="c15_end_penalty" name="Penalty applied"/>
    <bpmn:serviceTask id="c15_task_bounty" name="Integrity credit — one of the largest"/>
    <bpmn:serviceTask id="c15_task_record" name="Save a decision record"/>
    <bpmn:serviceTask id="c15_task_feed_c11" name="Report the distortion to Justice"/>
    <bpmn:endEvent id="c15_end_balance" name="C_15 tally updated"/>
    <bpmn:sequenceFlow id="c15_f1" sourceRef="c15_start" targetRef="c15_task_corrob"/>
    <bpmn:sequenceFlow id="c15_f2" sourceRef="c15_task_corrob" targetRef="c15_gw_corr"/>
    <bpmn:sequenceFlow id="c15_f3" name="no" sourceRef="c15_gw_corr" targetRef="c15_task_penalty"/>
    <bpmn:sequenceFlow id="c15_f4" sourceRef="c15_task_penalty" targetRef="c15_end_penalty"/>
    <bpmn:sequenceFlow id="c15_f5" name="yes" sourceRef="c15_gw_corr" targetRef="c15_task_audit"/>
    <bpmn:sequenceFlow id="c15_f6" sourceRef="c15_task_audit" targetRef="c15_task_bounty"/>
    <bpmn:sequenceFlow id="c15_f7" sourceRef="c15_task_bounty" targetRef="c15_task_record"/>
    <bpmn:sequenceFlow id="c15_f8" sourceRef="c15_task_record" targetRef="c15_task_feed_c11"/>
    <bpmn:sequenceFlow id="c15_f9" sourceRef="c15_task_feed_c11" targetRef="c15_end_balance"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_c15">
