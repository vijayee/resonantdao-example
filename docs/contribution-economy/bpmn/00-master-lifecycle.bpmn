      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ml_task_t2_r2_di" bpmnElement="ml_task_t2_r2">
        <dc:Bounds x="1300" y="755" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ml_gw_t2_join_di" bpmnElement="ml_gw_t2_join">
