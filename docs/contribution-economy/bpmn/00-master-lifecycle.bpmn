<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_ml" targetNamespace="http://resonantdao.com/bpmn">
  <bpmn:process id="Process_ml" name="Master Contribution Lifecycle" isExecutable="false">
    <bpmn:laneSet id="LaneSet_ml">
      <bpmn:lane id="ml_lane_member" name="Member">
        <bpmn:flowNodeRef>ml_start</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="ml_lane_evidence" name="Evidence Layer">
        <bpmn:flowNodeRef>ml_task_evidence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ml_gw_provenance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ml_end_rejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="ml_lane_classifier" name="Classifier">
        <bpmn:flowNodeRef>ml_task_classify</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="ml_lane_verification" name="Verification">
        <bpmn:flowNodeRef>ml_gw_tier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ml_task_t0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ml_task_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ml_task_t1_audit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ml_task_t2_conflict</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ml_gw_t2_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ml_task_t2_r1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ml_task_t2_r2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ml_gw_t2_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ml_gw_verdict</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ml_task_appeal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ml_end_unverified</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="ml_lane_balance" name="Balance Engine">
        <bpmn:flowNodeRef>ml_task_harm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ml_task_delta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ml_task_record</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="ml_lane_cycle" name="Cycle Operators">
        <bpmn:flowNodeRef>ml_event_cycle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ml_task_rct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ml_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="ml_start" name="Member performs action"/>
    <bpmn:userTask id="ml_task_evidence" name="Record evidence: action, context, provenance, outcome (C_2 rails)"/>
    <bpmn:exclusiveGateway id="ml_gw_provenance" name="Provenance valid?"/>
    <bpmn:endEvent id="ml_end_rejected" name="No evidence — null stays null (never 0)"/>
    <bpmn:serviceTask id="ml_task_classify" name="Classify: propose sparse vector P(a) = [p_0 … p_21]"/>
    <bpmn:exclusiveGateway id="ml_gw_tier" name="Review tier"/>
    <bpmn:serviceTask id="ml_task_t0" name="Automatic verification"/>
    <bpmn:serviceTask id="ml_task_t1" name="Machine-proposed check"/>
    <bpmn:userTask id="ml_task_t1_audit" name="Random audit sample"/>
    <bpmn:userTask id="ml_task_t2_conflict" name="Conflict-of-interest check"/>
    <bpmn:parallelGateway id="ml_gw_t2_split" name="Spawn independent reviews"/>
    <bpmn:userTask id="ml_task_t2_r1" name="Reviewer 1: written reasons"/>
    <bpmn:userTask id="ml_task_t2_r2" name="Reviewer 2: written reasons"/>
    <bpmn:parallelGateway id="ml_gw_t2_join" name="Merge reviewer verdicts"/>
    <bpmn:exclusiveGateway id="ml_gw_verdict" name="Verified?"/>
    <bpmn:userTask id="ml_task_appeal" name="Appeal (deadline-bound, Tier 3 rotating panel)"/>
    <bpmn:endEvent id="ml_end_unverified" name="Unverified — no delta, judgment stays pending (settles retroactively)"/>
    <bpmn:serviceTask id="ml_task_harm" name="Harm check — verified harm reduces or voids outcome"/>
    <bpmn:serviceTask id="ml_task_delta" name="Delta C_i(a) = Match_i × Outcome × Verification × Calibration_i → 22 non-transferable balances"/>
    <bpmn:serviceTask id="ml_task_record" name="Emit explanation record (action ID, dimensions, intensities, calibration version)"/>
    <bpmn:intermediateThrowEvent id="ml_event_cycle" name="Cycle boundary (C_10 Wheel → C_20 Judgement → C_21 World)"/>
    <bpmn:serviceTask id="ml_task_rct" name="Aggregate $RCT (see 21-aggregation-rct.bpmn)"/>
    <bpmn:endEvent id="ml_end" name="Balances updated — 22-vector remains source record"/>
    <bpmn:sequenceFlow id="ml_f1" sourceRef="ml_start" targetRef="ml_task_evidence"/>
    <bpmn:sequenceFlow id="ml_f2" sourceRef="ml_task_evidence" targetRef="ml_gw_provenance"/>
    <bpmn:sequenceFlow id="ml_f3" name="no" sourceRef="ml_gw_provenance" targetRef="ml_end_rejected"/>
    <bpmn:sequenceFlow id="ml_f4" name="yes" sourceRef="ml_gw_provenance" targetRef="ml_task_classify"/>
    <bpmn:sequenceFlow id="ml_f5" sourceRef="ml_task_classify" targetRef="ml_gw_tier"/>
    <bpmn:sequenceFlow id="ml_f6" name="Tier 0" sourceRef="ml_gw_tier" targetRef="ml_task_t0"/>
    <bpmn:sequenceFlow id="ml_f7" name="Tier 1" sourceRef="ml_gw_tier" targetRef="ml_task_t1"/>
    <bpmn:sequenceFlow id="ml_f8" name="Tier 2+" sourceRef="ml_gw_tier" targetRef="ml_task_t2_conflict"/>
    <bpmn:sequenceFlow id="ml_f9" sourceRef="ml_task_t0" targetRef="ml_gw_verdict"/>
    <bpmn:sequenceFlow id="ml_f10" sourceRef="ml_task_t1" targetRef="ml_task_t1_audit"/>
    <bpmn:sequenceFlow id="ml_f11" sourceRef="ml_task_t1_audit" targetRef="ml_gw_verdict"/>
    <bpmn:sequenceFlow id="ml_f12" sourceRef="ml_task_t2_conflict" targetRef="ml_gw_t2_split"/>
    <bpmn:sequenceFlow id="ml_f13" sourceRef="ml_gw_t2_split" targetRef="ml_task_t2_r1"/>
    <bpmn:sequenceFlow id="ml_f14" sourceRef="ml_gw_t2_split" targetRef="ml_task_t2_r2"/>
    <bpmn:sequenceFlow id="ml_f15" sourceRef="ml_task_t2_r1" targetRef="ml_gw_t2_join"/>
    <bpmn:sequenceFlow id="ml_f16" sourceRef="ml_task_t2_r2" targetRef="ml_gw_t2_join"/>
    <bpmn:sequenceFlow id="ml_f17" sourceRef="ml_gw_t2_join" targetRef="ml_gw_verdict"/>
    <bpmn:sequenceFlow id="ml_f18" name="no" sourceRef="ml_gw_verdict" targetRef="ml_task_appeal"/>
    <bpmn:sequenceFlow id="ml_f19" sourceRef="ml_task_appeal" targetRef="ml_end_unverified"/>
    <bpmn:sequenceFlow id="ml_f20" name="verdict revised" sourceRef="ml_task_appeal" targetRef="ml_gw_verdict"/>
    <bpmn:sequenceFlow id="ml_f21" name="yes" sourceRef="ml_gw_verdict" targetRef="ml_task_harm"/>
    <bpmn:sequenceFlow id="ml_f22" sourceRef="ml_task_harm" targetRef="ml_task_delta"/>
    <bpmn:sequenceFlow id="ml_f23" sourceRef="ml_task_delta" targetRef="ml_task_record"/>
    <bpmn:sequenceFlow id="ml_f24" sourceRef="ml_task_record" targetRef="ml_event_cycle"/>
    <bpmn:sequenceFlow id="ml_f25" sourceRef="ml_event_cycle" targetRef="ml_task_rct"/>
    <bpmn:sequenceFlow id="ml_f26" sourceRef="ml_task_rct" targetRef="ml_end"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_ml">
    <bpmndi:BPMNPlane id="Plane_ml" bpmnElement="Process_ml">
      <bpmndi:BPMNShape id="ml_pool_di" bpmnElement="Process_ml" isHorizontal="true">
        <dc:Bounds x="80" y="80" width="2200" height="1080"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ml_lane_member_di" bpmnElement="ml_lane_member" isHorizontal="true">
        <dc:Bounds x="110" y="80" width="2170" height="150"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ml_lane_evidence_di" bpmnElement="ml_lane_evidence" isHorizontal="true">
        <dc:Bounds x="110" y="230" width="2170" height="150"/>
