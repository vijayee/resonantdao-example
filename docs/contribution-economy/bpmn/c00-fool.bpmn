      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="c00_end_value_di" bpmnElement="c00_end_value">
        <dc:Bounds x="1120" y="528" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="c00_f1_di" bpmnElement="c00_f1">
