      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="c00_f5_di" bpmnElement="c00_f5">
        <di:waypoint x="610" y="360"/><di:waypoint x="650" y="360"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="c00_f6_di" bpmnElement="c00_f6">
