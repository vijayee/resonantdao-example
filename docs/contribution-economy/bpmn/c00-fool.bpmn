<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_c00" targetNamespace="http://resonantdao.com/bpmn">
  <bpmn:process id="Process_c00" name="C_0 Fool — Entry" isExecutable="false">
    <bpmn:laneSet id="LaneSet_c00">
      <bpmn:lane id="c00_lane_member" name="Member">
        <bpmn:flowNodeRef>c00_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c00_task_evidence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c00_end_zero</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="c00_lane_reviewer" name="Human Reviewer">
        <bpmn:flowNodeRef>c00_task_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c00_gw_crossing</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="c00_lane_system" name="System / Automation">
        <bpmn:flowNodeRef>c00_gw_sybil</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c00_end_sybil</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c00_task_record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c00_task_feed_c17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c00_end_value</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="c00_start" name="Entry action into unworked territory"/>
    <bpmn:userTask id="c00_task_evidence" name="Submit entry evidence"/>
    <bpmn:exclusiveGateway id="c00_gw_sybil" name="Sybil check passed?"/>
    <bpmn:endEvent id="c00_end_sybil" name="No entry credit (Sybil)"/>
    <bpmn:userTask id="c00_task_review" name="Validate crossing (reviewer)"/>
    <bpmn:exclusiveGateway id="c00_gw_crossing" name="Crossing validated?"/>
    <bpmn:endEvent id="c00_end_zero" name="Entry event = verified zero (recorded, no payment)"/>
    <bpmn:serviceTask id="c00_task_record" name="Emit explanation record (action ID, dimensions, intensities, calibration version)"/>
    <bpmn:serviceTask id="c00_task_feed_c17" name="Feed C_17 Star: orientation progress"/>
    <bpmn:endEvent id="c00_end_value" name="Validated crossing earns non-zero value"/>
    <bpmn:sequenceFlow id="c00_f1" sourceRef="c00_start" targetRef="c00_task_evidence"/>
    <bpmn:sequenceFlow id="c00_f2" sourceRef="c00_task_evidence" targetRef="c00_gw_sybil"/>
    <bpmn:sequenceFlow id="c00_f3" name="no" sourceRef="c00_gw_sybil" targetRef="c00_end_sybil"/>
    <bpmn:sequenceFlow id="c00_f4" name="yes" sourceRef="c00_gw_sybil" targetRef="c00_task_review"/>
    <bpmn:sequenceFlow id="c00_f5" sourceRef="c00_task_review" targetRef="c00_gw_crossing"/>
    <bpmn:sequenceFlow id="c00_f6" name="no" sourceRef="c00_gw_crossing" targetRef="c00_end_zero"/>
    <bpmn:sequenceFlow id="c00_f7" name="yes" sourceRef="c00_gw_crossing" targetRef="c00_task_record"/>
    <bpmn:sequenceFlow id="c00_f8" sourceRef="c00_task_record" targetRef="c00_task_feed_c17"/>
    <bpmn:sequenceFlow id="c00_f9" sourceRef="c00_task_feed_c17" targetRef="c00_end_value"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_c00">
    <bpmndi:BPMNPlane id="Plane_c00" bpmnElement="Process_c00">
      <bpmndi:BPMNShape id="c00_pool_di" bpmnElement="Process_c00" isHorizontal="true">
        <dc:Bounds x="80" y="80" width="1160" height="560"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="c00_lane_member_di" bpmnElement="c00_lane_member" isHorizontal="true">
