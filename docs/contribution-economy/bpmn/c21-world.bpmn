<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_c21" targetNamespace="http://resonantdao.com/bpmn">
  <bpmn:process id="Process_c21" name="C_21 World — Completion" isExecutable="false">
    <bpmn:laneSet id="LaneSet_c21">
    <bpmn:lane id="c21_lane_member" name="Member">
      <bpmn:flowNodeRef>c21_start</bpmn:flowNodeRef>
    </bpmn:lane>
    <bpmn:lane id="c21_lane_reviewer" name="Reviewer">
      <bpmn:flowNodeRef>c21_task_verify</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>c21_gw_settled</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>c21_end_incomplete</bpmn:flowNodeRef>
    </bpmn:lane>
    <bpmn:lane id="c21_lane_system" name="System">
      <bpmn:flowNodeRef>c21_task_credit</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>c21_task_record</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>c21_task_close</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>c21_end_balance</bpmn:flowNodeRef>
    </bpmn:lane>
  </bpmn:laneSet>
  <bpmn:startEvent id="c21_start" name="Someone claims the whole round is done"/>
  <bpmn:userTask id="c21_task_verify" name="A person confirms the round completed"/>
  <bpmn:exclusiveGateway id="c21_gw_settled" name="Is every part of the round settled?"/>
  <bpmn:endEvent id="c21_end_incomplete" name="Incomplete — defer"/>
  <bpmn:serviceTask id="c21_task_credit" name="Credit the completion"/>
  <bpmn:serviceTask id="c21_task_record" name="Save a decision record"/>
  <bpmn:serviceTask id="c21_task_close" name="Close the round so scores can publish"/>
  <bpmn:endEvent id="c21_end_balance" name="C_21 tally updated"/>
  <bpmn:sequenceFlow id="c21_f1" sourceRef="c21_start" targetRef="c21_task_verify"/>
  <bpmn:sequenceFlow id="c21_f2" sourceRef="c21_task_verify" targetRef="c21_gw_settled"/>
  <bpmn:sequenceFlow id="c21_f3" name="no" sourceRef="c21_gw_settled" targetRef="c21_end_incomplete"/>
  <bpmn:sequenceFlow id="c21_f4" name="yes" sourceRef="c21_gw_settled" targetRef="c21_task_credit"/>
  <bpmn:sequenceFlow id="c21_f5" sourceRef="c21_task_credit" targetRef="c21_task_record"/>
  <bpmn:sequenceFlow id="c21_f6" sourceRef="c21_task_record" targetRef="c21_task_close"/>
  <bpmn:sequenceFlow id="c21_f7" sourceRef="c21_task_close" targetRef="c21_end_balance"/>
</bpmn:process>
<bpmndi:BPMNDiagram id="Diagram_c21">
  <bpmndi:BPMNPlane id="Plane_c21" bpmnElement="Process_c21">
    <bpmndi:BPMNShape id="c21_pool_di" bpmnElement="Process_c21" isHorizontal="true">
      <dc:Bounds x="80" y="80" width="1240" height="560"/>
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="c21_lane_member_di" bpmnElement="c21_lane_member" isHorizontal="true">
      <dc:Bounds x="110" y="80" width="1210" height="186"/>
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="c21_lane_reviewer_di" bpmnElement="c21_lane_reviewer" isHorizontal="true">
      <dc:Bounds x="110" y="266" width="1210" height="186"/>
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="c21_lane_system_di" bpmnElement="c21_lane_system" isHorizontal="true">
      <dc:Bounds x="110" y="452" width="1210" height="188"/>
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="c21_start_di" bpmnElement="c21_start">
      <dc:Bounds x="220" y="156" width="36" height="36"/>
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="c21_task_verify_di" bpmnElement="c21_task_verify">
      <dc:Bounds x="320" y="320" width="100" height="80"/>
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="c21_gw_settled_di" bpmnElement="c21_gw_settled">
      <dc:Bounds x="500" y="335" width="50" height="50"/>
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="c21_end_incomplete_di" bpmnElement="c21_end_incomplete">
      <dc:Bounds x="700" y="342" width="36" height="36"/>
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="c21_task_credit_di" bpmnElement="c21_task_credit">
      <dc:Bounds x="600" y="506" width="100" height="80"/>
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="c21_task_record_di" bpmnElement="c21_task_record">
      <dc:Bounds x="760" y="506" width="100" height="80"/>
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="c21_task_close_di" bpmnElement="c21_task_close">
      <dc:Bounds x="920" y="506" width="100" height="80"/>
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="c21_end_balance_di" bpmnElement="c21_end_balance">
      <dc:Bounds x="1100" y="528" width="36" height="36"/>
    </bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="c21_f1_di" bpmnElement="c21_f1">
      <di:waypoint x="256" y="174"/><di:waypoint x="290" y="174"/><di:waypoint x="290" y="360"/><di:waypoint x="320" y="360"/>
    </bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="c21_f2_di" bpmnElement="c21_f2">
      <di:waypoint x="420" y="360"/><di:waypoint x="500" y="360"/>
    </bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="c21_f3_di" bpmnElement="c21_f3">
      <di:waypoint x="550" y="360"/><di:waypoint x="700" y="360"/>
    </bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="c21_f4_di" bpmnElement="c21_f4">
      <di:waypoint x="525" y="385"/><di:waypoint x="525" y="546"/><di:waypoint x="600" y="546"/>
    </bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="c21_f5_di" bpmnElement="c21_f5">
      <di:waypoint x="700" y="546"/><di:waypoint x="760" y="546"/>
    </bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="c21_f6_di" bpmnElement="c21_f6">
      <di:waypoint x="860" y="546"/><di:waypoint x="920" y="546"/>
    </bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="c21_f7_di" bpmnElement="c21_f7">
      <di:waypoint x="1020" y="546"/><di:waypoint x="1100" y="546"/>
    </bpmndi:BPMNEdge>
  </bpmndi:BPMNPlane>
</bpmndi:BPMNDiagram>
</bpmn:definitions>
