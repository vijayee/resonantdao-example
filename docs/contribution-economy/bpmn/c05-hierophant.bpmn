                  id="Definitions_c05" targetNamespace="http://resonantdao.com/bpmn">
  <bpmn:process id="Process_c05" name="C_5 Hierophant — Teaching" isExecutable="false">
    <bpmn:laneSet id="LaneSet_c05">
      <bpmn:lane id="c05_lane_member" name="Member">
        <bpmn:flowNodeRef>c05_start</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="c05_lane_reviewer" name="Reviewer">
        <bpmn:flowNodeRef>c05_task_review</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="c05_lane_system" name="System">
        <bpmn:flowNodeRef>c05_gw_lecture</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c05_end_nocredit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c05_task_credit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c05_task_record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c05_task_feed_c03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c05_end_balance</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="c05_start" name="Someone claims they taught"/>
    <bpmn:exclusiveGateway id="c05_gw_lecture" name="Only a lecture or attendance?"/>
    <bpmn:endEvent id="c05_end_nocredit" name="No credit — lectures alone pay nothing"/>
    <bpmn:userTask id="c05_task_review" name="A reviewer confirms someone can do it"/>
    <bpmn:serviceTask id="c05_task_credit" name="Credit the teacher"/>
    <bpmn:serviceTask id="c05_task_record" name="Save a decision record"/>
    <bpmn:serviceTask id="c05_task_feed_c03" name="Share as nurture evidence with Empress"/>
    <bpmn:endEvent id="c05_end_balance" name="C_5 tally updated"/>
    <bpmn:sequenceFlow id="c05_f1" sourceRef="c05_start" targetRef="c05_gw_lecture"/>
    <bpmn:sequenceFlow id="c05_f2" name="yes" sourceRef="c05_gw_lecture" targetRef="c05_end_nocredit"/>
    <bpmn:sequenceFlow id="c05_f3" name="no" sourceRef="c05_gw_lecture" targetRef="c05_task_review"/>
    <bpmn:sequenceFlow id="c05_f4" sourceRef="c05_task_review" targetRef="c05_task_credit"/>
    <bpmn:sequenceFlow id="c05_f5" sourceRef="c05_task_credit" targetRef="c05_task_record"/>
    <bpmn:sequenceFlow id="c05_f6" sourceRef="c05_task_record" targetRef="c05_task_feed_c03"/>
    <bpmn:sequenceFlow id="c05_f7" sourceRef="c05_task_feed_c03" targetRef="c05_end_balance"/>
  </bpmn:process>
