                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_c19" targetNamespace="http://resonantdao.com/bpmn">
  <bpmn:process id="Process_c19" name="C_19 Sun — Public Recognition" isExecutable="false">
    <bpmn:laneSet id="LaneSet_c19">
      <bpmn:lane id="c19_lane_member" name="Member">
        <bpmn:flowNodeRef>c19_start</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="c19_lane_reviewer" name="Human Reviewer">
        <bpmn:flowNodeRef>c19_task_review</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="c19_lane_system" name="System / Automation">
        <bpmn:flowNodeRef>c19_gw_verified</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c19_end_rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c19_task_credit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c19_task_record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c19_task_feed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c19_end_balance</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="c19_start" name="Recognition nomination"/>
    <bpmn:exclusiveGateway id="c19_gw_verified" name="Tied to verified record?"/>
    <bpmn:endEvent id="c19_end_rejected" name="Rejected (popularity alone pays nothing)"/>
    <bpmn:userTask id="c19_task_review" name="Recognition review"/>
    <bpmn:serviceTask id="c19_task_credit" name="Recognition credit"/>
    <bpmn:serviceTask id="c19_task_record" name="Emit explanation record"/>
    <bpmn:serviceTask id="c19_task_feed" name="Feed C_2 Priestess: recognized record link"/>
    <bpmn:endEvent id="c19_end_balance" name="C_19 balance updated"/>
    <bpmn:sequenceFlow id="c19_f1" sourceRef="c19_start" targetRef="c19_gw_verified"/>
    <bpmn:sequenceFlow id="c19_f2" name="no" sourceRef="c19_gw_verified" targetRef="c19_end_rejected"/>
    <bpmn:sequenceFlow id="c19_f3" name="yes" sourceRef="c19_gw_verified" targetRef="c19_task_review"/>
    <bpmn:sequenceFlow id="c19_f4" sourceRef="c19_task_review" targetRef="c19_task_credit"/>
    <bpmn:sequenceFlow id="c19_f5" sourceRef="c19_task_credit" targetRef="c19_task_record"/>
    <bpmn:sequenceFlow id="c19_f6" sourceRef="c19_task_record" targetRef="c19_task_feed"/>
    <bpmn:sequenceFlow id="c19_f7" sourceRef="c19_task_feed" targetRef="c19_end_balance"/>
  </bpmn:process>
