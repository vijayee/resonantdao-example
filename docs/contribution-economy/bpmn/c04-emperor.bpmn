<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_c04" targetNamespace="http://resonantdao.com/bpmn">
  <bpmn:process id="Process_c04" name="C_4 Emperor — Rule Changes" isExecutable="false">
    <bpmn:laneSet id="LaneSet_c04">
      <bpmn:lane id="c04_lane_member" name="Member">
        <bpmn:flowNodeRef>c04_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c04_task_draft</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="c04_lane_reviewer" name="Reviewer">
        <bpmn:flowNodeRef>c04_task_vote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c04_gw_adopted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c04_end_none</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="c04_lane_system" name="System">
        <bpmn:flowNodeRef>c04_task_bounty</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c04_task_record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c04_task_feed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c04_end_balance</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="c04_start" name="Someone proposes a rule change"/>
    <bpmn:userTask id="c04_task_draft" name="Draft the change"/>
    <bpmn:userTask id="c04_task_vote" name="Members vote to adopt it"/>
    <bpmn:exclusiveGateway id="c04_gw_adopted" name="Adopted?"/>
    <bpmn:endEvent id="c04_end_none" name="No reward — a proposal alone pays nothing"/>
    <bpmn:serviceTask id="c04_task_bounty" name="Reward the adopted change"/>
    <bpmn:serviceTask id="c04_task_record" name="Save a decision record"/>
    <bpmn:serviceTask id="c04_task_feed" name="New rule becomes a tuning version"/>
    <bpmn:endEvent id="c04_end_balance" name="C_4 tally updated"/>
    <bpmn:sequenceFlow id="c04_f1" sourceRef="c04_start" targetRef="c04_task_draft"/>
    <bpmn:sequenceFlow id="c04_f2" sourceRef="c04_task_draft" targetRef="c04_task_vote"/>
    <bpmn:sequenceFlow id="c04_f3" sourceRef="c04_task_vote" targetRef="c04_gw_adopted"/>
    <bpmn:sequenceFlow id="c04_f4" name="no" sourceRef="c04_gw_adopted" targetRef="c04_end_none"/>
    <bpmn:sequenceFlow id="c04_f5" name="yes" sourceRef="c04_gw_adopted" targetRef="c04_task_bounty"/>
    <bpmn:sequenceFlow id="c04_f6" sourceRef="c04_task_bounty" targetRef="c04_task_record"/>
    <bpmn:sequenceFlow id="c04_f7" sourceRef="c04_task_record" targetRef="c04_task_feed"/>
    <bpmn:sequenceFlow id="c04_f8" sourceRef="c04_task_feed" targetRef="c04_end_balance"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_c04">
    <bpmndi:BPMNPlane id="Plane_c04" bpmnElement="Process_c04">
      <bpmndi:BPMNShape id="c04_pool_di" bpmnElement="Process_c04" isHorizontal="true">
        <dc:Bounds x="80" y="80" width="1140" height="560"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="c04_lane_member_di" bpmnElement="c04_lane_member" isHorizontal="true">
        <dc:Bounds x="110" y="80" width="1110" height="186"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="c04_lane_reviewer_di" bpmnElement="c04_lane_reviewer" isHorizontal="true">
        <dc:Bounds x="110" y="266" width="1110" height="186"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="c04_lane_system_di" bpmnElement="c04_lane_system" isHorizontal="true">
        <dc:Bounds x="110" y="452" width="1110" height="188"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="c04_start_di" bpmnElement="c04_start">
        <dc:Bounds x="154" y="156" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="c04_task_draft_di" bpmnElement="c04_task_draft">
        <dc:Bounds x="250" y="134" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="c04_task_vote_di" bpmnElement="c04_task_vote">
        <dc:Bounds x="400" y="320" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="c04_gw_adopted_di" bpmnElement="c04_gw_adopted">
        <dc:Bounds x="550" y="335" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="c04_end_none_di" bpmnElement="c04_end_none">
        <dc:Bounds x="557" y="412" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="c04_task_bounty_di" bpmnElement="c04_task_bounty">
        <dc:Bounds x="680" y="506" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="c04_task_record_di" bpmnElement="c04_task_record">
        <dc:Bounds x="820" y="506" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="c04_task_feed_di" bpmnElement="c04_task_feed">
        <dc:Bounds x="960" y="506" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="c04_end_balance_di" bpmnElement="c04_end_balance">
        <dc:Bounds x="1120" y="528" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="c04_f1_di" bpmnElement="c04_f1">
        <di:waypoint x="190" y="174"/><di:waypoint x="250" y="174"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="c04_f2_di" bpmnElement="c04_f2">
        <di:waypoint x="350" y="174"/><di:waypoint x="375" y="174"/><di:waypoint x="375" y="360"/><di:waypoint x="400" y="360"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="c04_f3_di" bpmnElement="c04_f3">
        <di:waypoint x="500" y="360"/><di:waypoint x="550" y="360"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="c04_f4_di" bpmnElement="c04_f4">
        <di:waypoint x="575" y="385"/><di:waypoint x="575" y="412"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="c04_f5_di" bpmnElement="c04_f5">
        <di:waypoint x="600" y="360"/><di:waypoint x="730" y="360"/><di:waypoint x="730" y="506"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="c04_f6_di" bpmnElement="c04_f6">
        <di:waypoint x="780" y="546"/><di:waypoint x="820" y="546"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="c04_f7_di" bpmnElement="c04_f7">
        <di:waypoint x="920" y="546"/><di:waypoint x="960" y="546"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="c04_f8_di" bpmnElement="c04_f8">
        <di:waypoint x="1060" y="546"/><di:waypoint x="1120" y="546"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
