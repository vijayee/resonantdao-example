        <bpmn:flowNodeRef>c13_end_balance</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="c13_start" name="Someone ends a project"/>
    <bpmn:parallelGateway id="c13_gw_split"/>
    <bpmn:userTask id="c13_task_learning" name="Check the learning was preserved"/>
    <bpmn:userTask id="c13_task_release" name="Confirm resources were released"/>
    <bpmn:parallelGateway id="c13_gw_join"/>
    <bpmn:exclusiveGateway id="c13_gw_real" name="Was it ended, not abandoned?"/>
    <bpmn:endEvent id="c13_end_reject" name="Rejected — it was theater"/>
    <bpmn:serviceTask id="c13_task_token" name="Credit the one who closed it"/>
    <bpmn:serviceTask id="c13_task_record" name="Save a decision record"/>
    <bpmn:serviceTask id="c13_task_feed_c14" name="Released resources feed Temperance"/>
    <bpmn:endEvent id="c13_end_balance" name="C_13 tally updated"/>
    <bpmn:sequenceFlow id="c13_f1" sourceRef="c13_start" targetRef="c13_gw_split"/>
    <bpmn:sequenceFlow id="c13_f2" sourceRef="c13_gw_split" targetRef="c13_task_learning"/>
