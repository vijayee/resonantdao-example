    <bpmn:sequenceFlow id="c13_f7" name="no" sourceRef="c13_gw_real" targetRef="c13_end_reject"/>
    <bpmn:sequenceFlow id="c13_f8" name="yes" sourceRef="c13_gw_real" targetRef="c13_task_token"/>
    <bpmn:sequenceFlow id="c13_f9" sourceRef="c13_task_token" targetRef="c13_task_record"/>
    <bpmn:sequenceFlow id="c13_f10" sourceRef="c13_task_record" targetRef="c13_task_feed_c14"/>
