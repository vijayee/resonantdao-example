  <bpmn:process id="Process_c13" name="C_13 Death — Ending" isExecutable="false">
    <bpmn:laneSet id="LaneSet_c13">
      <bpmn:lane id="c13_lane_member" name="Member">
        <bpmn:flowNodeRef>c13_start</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="c13_lane_reviewer" name="Reviewer">
        <bpmn:flowNodeRef>c13_gw_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c13_task_learning</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="c13_lane_system" name="System">
        <bpmn:flowNodeRef>c13_task_release</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c13_gw_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c13_gw_real</bpmn:flowNodeRef>
