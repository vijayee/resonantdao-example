<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_c20" targetNamespace="http://resonantdao.com/bpmn">
  <bpmn:process id="Process_c20" name="C_20 Judgement — Reckoning" isExecutable="false">
    <bpmn:laneSet id="LaneSet_c20">
      <bpmn:lane id="c20_lane_member" name="Member">
        <bpmn:flowNodeRef>c20_start</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="c20_lane_reviewer" name="Human Reviewer">
        <bpmn:flowNodeRef>c20_task_settle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c20_gw_unres</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="c20_lane_system" name="System / Automation">
        <bpmn:flowNodeRef>c20_task_pending</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c20_task_credit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c20_task_record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c20_task_agg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c20_end_balance</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="c20_start" name="Cycle reckoning"/>
    <bpmn:userTask id="c20_task_settle" name="Provenance settlement (human-only bootstrap)"/>
    <bpmn:exclusiveGateway id="c20_gw_unres" name="Unresolved judgments?"/>
    <bpmn:serviceTask id="c20_task_pending" name="Keep pending (settles retroactively when evidence arrives)"/>
    <bpmn:serviceTask id="c20_task_credit" name="Reckoning credit"/>
    <bpmn:serviceTask id="c20_task_record" name="Emit explanation record"/>
    <bpmn:serviceTask id="c20_task_agg" name="Fire aggregation precondition (provenance settled)"/>
    <bpmn:endEvent id="c20_end_balance" name="C_20 balance updated"/>
    <bpmn:sequenceFlow id="c20_f1" sourceRef="c20_start" targetRef="c20_task_settle"/>
    <bpmn:sequenceFlow id="c20_f2" sourceRef="c20_task_settle" targetRef="c20_gw_unres"/>
    <bpmn:sequenceFlow id="c20_f3" name="yes" sourceRef="c20_gw_unres" targetRef="c20_task_pending"/>
    <bpmn:sequenceFlow id="c20_f4" name="next cycle" sourceRef="c20_task_pending" targetRef="c20_gw_unres"/>
    <bpmn:sequenceFlow id="c20_f5" name="no" sourceRef="c20_gw_unres" targetRef="c20_task_credit"/>
    <bpmn:sequenceFlow id="c20_f6" sourceRef="c20_task_credit" targetRef="c20_task_record"/>
    <bpmn:sequenceFlow id="c20_f7" sourceRef="c20_task_record" targetRef="c20_task_agg"/>
    <bpmn:sequenceFlow id="c20_f8" sourceRef="c20_task_agg" targetRef="c20_end_balance"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_c20">
    <bpmndi:BPMNPlane id="Plane_c20" bpmnElement="Process_c20">
      <bpmndi:BPMNShape id="c20_pool_di" bpmnElement="Process_c20" isHorizontal="true">
        <dc:Bounds x="80" y="80" width="1340" height="560"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="c20_lane_member_di" bpmnElement="c20_lane_member" isHorizontal="true">
        <dc:Bounds x="110" y="80" width="1310" height="186"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="c20_lane_reviewer_di" bpmnElement="c20_lane_reviewer" isHorizontal="true">
        <dc:Bounds x="110" y="266" width="1310" height="186"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="c20_lane_system_di" bpmnElement="c20_lane_system" isHorizontal="true">
        <dc:Bounds x="110" y="452" width="1310" height="188"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="c20_start_di" bpmnElement="c20_start">
        <dc:Bounds x="220" y="156" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="c20_task_settle_di" bpmnElement="c20_task_settle">
        <dc:Bounds x="320" y="320" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="c20_gw_unres_di" bpmnElement="c20_gw_unres">
        <dc:Bounds x="500" y="335" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="c20_task_pending_di" bpmnElement="c20_task_pending">
        <dc:Bounds x="760" y="506" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="c20_task_credit_di" bpmnElement="c20_task_credit">
        <dc:Bounds x="600" y="506" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="c20_task_record_di" bpmnElement="c20_task_record">
        <dc:Bounds x="920" y="506" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="c20_task_agg_di" bpmnElement="c20_task_agg">
        <dc:Bounds x="1080" y="506" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="c20_end_balance_di" bpmnElement="c20_end_balance">
        <dc:Bounds x="1260" y="528" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="c20_f1_di" bpmnElement="c20_f1">
        <di:waypoint x="256" y="174"/><di:waypoint x="280" y="174"/><di:waypoint x="280" y="360"/><di:waypoint x="320" y="360"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="c20_f2_di" bpmnElement="c20_f2">
        <di:waypoint x="420" y="360"/><di:waypoint x="500" y="360"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="c20_f3_di" bpmnElement="c20_f3">
        <di:waypoint x="525" y="385"/><di:waypoint x="525" y="470"/><di:waypoint x="810" y="470"/><di:waypoint x="810" y="506"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="c20_f4_di" bpmnElement="c20_f4">
        <di:waypoint x="860" y="546"/><di:waypoint x="900" y="546"/><di:waypoint x="900" y="300"/><di:waypoint x="525" y="300"/><di:waypoint x="525" y="335"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="c20_f5_di" bpmnElement="c20_f5">
        <di:waypoint x="550" y="360"/><di:waypoint x="570" y="360"/><di:waypoint x="570" y="546"/><di:waypoint x="600" y="546"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="c20_f6_di" bpmnElement="c20_f6">
        <di:waypoint x="700" y="546"/><di:waypoint x="715" y="546"/><di:waypoint x="715" y="610"/><di:waypoint x="905" y="610"/><di:waypoint x="905" y="546"/><di:waypoint x="920" y="546"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="c20_f7_di" bpmnElement="c20_f7">
        <di:waypoint x="1020" y="546"/><di:waypoint x="1080" y="546"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="c20_f8_di" bpmnElement="c20_f8">
        <di:waypoint x="1180" y="546"/><di:waypoint x="1260" y="546"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
