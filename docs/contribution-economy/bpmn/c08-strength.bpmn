    <bpmn:sequenceFlow id="c08_f5" sourceRef="c08_task_verify" targetRef="c08_gw_join1"/>
    <bpmn:sequenceFlow id="c08_f6" sourceRef="c08_gw_join1" targetRef="c08_gw_qual"/>
    <bpmn:sequenceFlow id="c08_f7" name="no" sourceRef="c08_gw_qual" targetRef="c08_end_disqual"/>
    <bpmn:sequenceFlow id="c08_f8" name="yes" sourceRef="c08_gw_qual" targetRef="c08_task_token"/>
    <bpmn:sequenceFlow id="c08_f9" sourceRef="c08_task_token" targetRef="c08_gw_split2"/>
    <bpmn:sequenceFlow id="c08_f10" sourceRef="c08_gw_split2" targetRef="c08_task_acc_a"/>
    <bpmn:sequenceFlow id="c08_f11" sourceRef="c08_gw_split2" targetRef="c08_task_acc_b"/>
    <bpmn:sequenceFlow id="c08_f12" sourceRef="c08_task_acc_a" targetRef="c08_gw_join2"/>
    <bpmn:sequenceFlow id="c08_f13" sourceRef="c08_task_acc_b" targetRef="c08_gw_join2"/>
    <bpmn:sequenceFlow id="c08_f14" sourceRef="c08_gw_join2" targetRef="c08_gw_accepts"/>
    <bpmn:sequenceFlow id="c08_f15" name="no" sourceRef="c08_gw_accepts" targetRef="c08_end_nores"/>
    <bpmn:sequenceFlow id="c08_f16" name="yes" sourceRef="c08_gw_accepts" targetRef="c08_task_record"/>
    <bpmn:sequenceFlow id="c08_f17" sourceRef="c08_task_record" targetRef="c08_task_feed_c18"/>
    <bpmn:sequenceFlow id="c08_f18" sourceRef="c08_task_feed_c18" targetRef="c08_end_balance"/>
  </bpmn:process>
